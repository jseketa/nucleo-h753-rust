{
  "version": "2.0.0",
  "tasks": [
    {
      // Builds the firmware; launch.json runs this before every flash.
      // Also on Ctrl+Shift+B (default build task).
      "label": "cargo build",
      "type": "shell",
      "command": "cargo build",
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
